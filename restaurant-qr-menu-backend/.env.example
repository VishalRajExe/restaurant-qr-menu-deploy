# ------------------------------------------------------------------------------
# RESTAURANT QR MENU BACKEND — ENVIRONMENT VARIABLE TEMPLATE (.env)
# Copy this file to '.env' or export these environment variables in your runtime.
# ------------------------------------------------------------------------------

# ─── Application & URLs ───────────────────────────────────────────────────────
PORT=8080
FRONTEND_URL=http://localhost:4200
ADMIN_URL=http://localhost:4201
QR_BASE_URL=http://localhost:4200/menu
JWT_SECRET=7A25432A462D4A614E645267556B58703273357638792F423F4528482B4D6251

# ─── Global SMTP Settings ─────────────────────────────────────────────────────
MAIL_ENABLED=true
MAIL_FROM=noreply@restaurantqr.com
MAIL_TIMEOUT=5000

# ------------------------------------------------------------------------------
# OPTION A: Mailtrap (RECOMMENDED FOR LOCAL DEV & INTEGRATION TESTING)
# Sign up at https://mailtrap.io -> Inboxes -> SMTP Settings
# ------------------------------------------------------------------------------
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_SSL_ENABLE=false

# ------------------------------------------------------------------------------
# OPTION B: Gmail SMTP
# Requires 2-Step Verification + App Password generated in Google Account settings
# ------------------------------------------------------------------------------
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=16_char_app_password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_SMTP_SSL_ENABLE=false
# MAIL_FROM=your_email@gmail.com

# ------------------------------------------------------------------------------
# OPTION C: SendGrid SMTP
# Create an API Key in SendGrid console with Mail Send permissions
# ------------------------------------------------------------------------------
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your_sendgrid_api_key
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_SMTP_SSL_ENABLE=false
# MAIL_FROM=verified_sender@yourdomain.com

# ------------------------------------------------------------------------------
# OPTION D: Amazon SES (SMTP Interface)
# Generate SMTP credentials in AWS SES console for your region
# ------------------------------------------------------------------------------
# MAIL_HOST=email-smtp.us-east-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USERNAME=your_ses_smtp_username
# MAIL_PASSWORD=your_ses_smtp_password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_SMTP_SSL_ENABLE=false
# MAIL_FROM=verified_sender@yourdomain.com

# ------------------------------------------------------------------------------
# OPTION E: Mailpit / Mailhog (Local Docker Container)
# Run: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
# ------------------------------------------------------------------------------
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS_ENABLE=false
# MAIL_SMTP_SSL_ENABLE=false
# MAIL_FROM=no-reply@localhost
