{
  "info": {
    "name": "Restaurant QR Menu SaaS API - Complete 12-Phase Collection",
    "_postman_id": "restaurant-qr-menu-postman-collection-v3",
    "description": "Complete API collection for the Restaurant QR Menu SaaS platform covering all 12 Phases and all endpoints (CRUD, Subscriptions, Branch Management, Cancel, Reopen, Tickets, Media, Analytics, Enterprise).",
